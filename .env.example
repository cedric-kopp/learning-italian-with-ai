# --- LLM backend: which local engine powers the tutor's brain ---
# "ollama"  -> talks to `ollama serve` (OpenAI-compatible on :11434/v1)
# "mlx"     -> talks to `mlx_lm.server` (OpenAI-compatible on :8080/v1)
LLM_BACKEND=ollama

# Model id per backend (both speak the OpenAI API).
# gemma3:4b = fast + best Italian grammar on a base M4 (~6s/turn). Alternatives:
# qwen2.5:7b-instruct (balanced), qwen3:14b (best quality but ~17s/turn here).
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434/v1

MLX_MODEL=mlx-community/Qwen3-14B-4bit
MLX_BASE_URL=http://localhost:8080/v1

# --- Languages (prefer the wizard: `uv run python scripts/configure.py`) ---
# TARGET_LANG = the language you LEARN; NATIVE_LANG = explanations + card backs.
# Supported target languages: it, es, fr, pt, en (full) and ja (caveats).
TARGET_LANG=it
NATIVE_LANG=en
APP_NAME=Tutore
# TUTOR_NAME=Marco          # optional; defaults to the target language's persona

# --- Speech-to-text (mlx-whisper) ---
# Multilingual; large-v3-turbo is fast on Apple Silicon.
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# --- Text-to-speech (Kokoro) ---
# Voices default to the target/native language's registry voice; override here.
# TTS_VOICE_TARGET=im_nicola
# TTS_VOICE_NATIVE=am_michael

# --- Server ---
HOST=127.0.0.1
PORT=8770

# --- Storage ---
DB_PATH=data/tutore.db

# --- Anki flashcards ---
# Larger model used only for session-end card generation (slow but smart is fine).
CARD_MODEL=qwen3:14b
# AnkiConnect add-on HTTP server (Anki desktop must be open to push cards).
ANKI_CONNECT_URL=http://127.0.0.1:8765
ANKI_DECK=Tutore Italian
ANKI_TAGS=tutore,italian
